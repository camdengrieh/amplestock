{
  "name": "@amplestocks/abis",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Generated ABIs and typed contract configs for Amplestocks (wagmi CLI codegen from contracts/out)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "wagmi generate",
    "build": "node -e \"console.log('[abis] nothing to build until wagmi generate has run')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"console.log('[abis] no tests')\"",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@wagmi/cli": "^2.10.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
