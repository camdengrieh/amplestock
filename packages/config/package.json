{
  "name": "@amplestocks/config",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Chain ids, address book, launch token list and launch parameters for Amplestocks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./launch.json": "./launch.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "launch.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "lint": "tsc -p tsconfig.json --noEmit",
    "gen:json": "node scripts/gen-launch-json.ts"
  },
  "dependencies": {
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
