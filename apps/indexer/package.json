{
  "name": "@amplestocks/indexer",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Ponder indexer for Amplestocks — every protocol event, v4 swap fee decoding, uiMultiplier polling, NAV reconciliation and the denylist alarm",
  "type": "module",
  "scripts": {
    "dev": "ponder dev",
    "start": "ponder start",
    "serve": "ponder serve",
    "codegen": "ponder codegen",
    "build": "ponder codegen",
    "test": "vitest run",
    "test:e2e": "AMPS_E2E=1 vitest run test/e2e",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@amplestocks/abis": "workspace:*",
    "@amplestocks/config": "workspace:*",
    "hono": "4.13.7",
    "ponder": "0.17.9",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}
