# SPDX-License-Identifier: MIT
#
# Copy to `.env.local` (git-ignored) and fill in. Nothing here has a hard-coded default that points
# at a real deployment: every protocol address is deployment state and must be supplied.

# --- Chain ---------------------------------------------------------------------------------------
# 4663 mainnet, 46630 testnet, 31337 a local anvil.
AMPS_CHAIN_ID=4663
AMPS_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional. When set, Ponder uses it for the realtime tip and falls back to HTTP for history.
# AMPS_WS_URL=wss://robinhood-rpc.publicnode.com
# The block the vault was deployed in. Indexing from 0 on a live chain is a very long backfill.
AMPS_START_BLOCK=0
# AMPS_END_BLOCK=

# --- Addresses -----------------------------------------------------------------------------------
# Either point at the deployments file the deploy scripts write...
# AMPS_DEPLOYMENTS=../../contracts/script/config/deployments.json
# ...or set them one by one. These are the same names `deployments.json` lists under `envOverrides`.
AMPS_TOKEN=
AMPS_VAULT=
AMPS_REGISTRY=
AMPS_HOOK=
AMPS_BONDS=
AMPS_STAKING=
AMPS_BOUNTY_POT=
AMPS_ORACLE_GATE=
AMPS_FEED_REGISTRY=
AMPS_POOL_MANAGER=
AMPS_WETH9=
AMPS_USDG=
AMPS_TEAM_VESTING=
AMPS_CREATOR=
AMPS_TIMELOCK=
AMPS_GUARDIAN=

# --- Pool filter (optional, RPC cost only) --------------------------------------------------------
# The 32 pool ids, so the PoolManager subscription is a topic filter rather than every v4 swap on
# the chain. Either a comma-separated list or the pools.json `script/05_Registry.s.sol` writes.
# AMPS_POOL_IDS=0x...,0x...
# AMPS_POOLS=../../contracts/script/config/pools.json

# --- The denylist alarm ---------------------------------------------------------------------------
# The Stock Token beacon comes from `@amplestocks/config` on 4663. Add the implementation, the
# issuer admin key and the ACCESS_CONTROLLED_REGISTRY here once Phase 0 has identified them.
# AMPS_DENYLIST_WATCH=0x...,0x...

# --- Polling and reconciliation --------------------------------------------------------------------
# Block cadence of the uiMultiplier state diff and of the NAV/inventory heartbeat. On a 100 ms chain
# 300 blocks is ~30 s.
AMPS_MULTIPLIER_POLL_BLOCKS=300
AMPS_RECONCILE_POLL_BLOCKS=300
# Reconciliation also runs at every block that carried a NavCheckpoint. Leave this on.
AMPS_RECONCILE_ON_CHECKPOINT=true
# The dust bound: a pair passes within either of these. 2 bp is the same budget R1 allows a single
# compound to bleed; 1e12 wei is 1e-6 AMPS or 1e-6 USD at 18 decimals.
AMPS_DUST_BPS=2
AMPS_DUST_WEI=1000000000000

# --- Alerts ---------------------------------------------------------------------------------------
# Unset means record-only: every alert still lands in the `alert` table and is served at
# /api/alerts. Set this to POST each one as JSON as well.
# AMPS_ALERT_WEBHOOK=https://hooks.example.invalid/amps
AMPS_ALERT_WEBHOOK_TIMEOUT_MS=5000

# --- Database --------------------------------------------------------------------------------------
# Unset: PGlite under .ponder/pglite (local and CI). Set: Postgres (production).
# DATABASE_URL=postgres://user:pass@host:5432/amplestocks
# AMPS_PGLITE_DIR=.ponder/pglite
