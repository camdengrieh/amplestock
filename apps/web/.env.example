# SPDX-License-Identifier: MIT
#
# apps/web configuration. Every address below is a *deployment* address: it does not exist until
# the Phase 6 scripts have run, and it is deliberately not baked into `@amplestocks/config`, which
# holds only third-party reference data that Phase 0 re-verifies on chain. Nothing here is a
# secret; all of it ends up in the client bundle, which is why nothing here may be a private key.

# 4663 (Robinhood Chain) or 46630 (testnet).
NEXT_PUBLIC_AMPS_CHAIN_ID=46630

# Optional RPC override. Defaults to the chain's public RPC from @amplestocks/config.
NEXT_PUBLIC_AMPS_RPC_URL=

# Reown (WalletConnect) project id. Empty -> AppKit is not mounted and the app falls back to the
# injected connector only.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Amplestocks deployment. Empty -> the surface renders its "not deployed on this chain" state
# instead of issuing reads against the zero address.
NEXT_PUBLIC_AMPS_TOKEN=
NEXT_PUBLIC_AMPS_VAULT=
NEXT_PUBLIC_AMPS_QUOTER=
NEXT_PUBLIC_AMPS_BONDS=
NEXT_PUBLIC_AMPS_BONDS_LENS=
NEXT_PUBLIC_AMPS_STAKING=
NEXT_PUBLIC_AMPS_REGISTRY=
NEXT_PUBLIC_AMPS_REGISTRY_LENS=
NEXT_PUBLIC_AMPS_HOOK=
NEXT_PUBLIC_AMPS_ORACLE_GATE=
NEXT_PUBLIC_AMPS_TIMELOCK=

# Indexer (apps/indexer). Empty -> every indexed panel renders "indexer unavailable" rather than
# inventing a series.
NEXT_PUBLIC_AMPS_INDEXER_URL=

# Feature flags. "1" enables.
NEXT_PUBLIC_FLAG_ACROSS_ZAP=0
NEXT_PUBLIC_FLAG_TESTNET_BANNER=1

# Geo gate. `GEO_PROVIDER` selects the header the edge provider sets:
#   vercel      -> x-vercel-ip-country
#   cloudflare  -> cf-ipcountry
#   header      -> the header named by GEO_COUNTRY_HEADER
#   none        -> no IP signal; the self-attestation is the only gate (development default)
GEO_PROVIDER=none
GEO_COUNTRY_HEADER=x-geo-country
# Comma-separated ISO-3166-1 alpha-2 codes. Defaults to US,CA,GB,UK,CH.
GEO_BLOCKED_COUNTRIES=US,CA,GB,UK,CH
