{
  "name": "@amplestocks/keeper",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Amplestocks keeper: the permissionless bountied upkeep service (compound, rollout, deployBonded, checkpoint, touch)",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "node -e \"console.log('[keeper] runs from source under tsx; typecheck is the build gate')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:chain": "AMPS_KEEPER_CHAIN_TESTS=1 vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@amplestocks/abis": "workspace:*",
    "@amplestocks/config": "workspace:*",
    "tsx": "4.23.13",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}
