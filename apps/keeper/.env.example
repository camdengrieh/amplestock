# SPDX-License-Identifier: MIT
# Copy to `.env` and fill in. Nothing here is a secret except the two keys, and `.env` is gitignored.

# --- chain -------------------------------------------------------------------------------------------------
AMPS_CHAIN_ID=46630
# Leave empty to use the @amplestocks/config default for the chain id above.
AMPS_RPC_URL=

# --- the one address the keeper is told; everything else is resolved from it ---------------------------------
AMPS_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# --- submitter ----------------------------------------------------------------------------------------------
AMPS_SUBMITTER=relayer
AMPS_SENDER_ADDRESS=0x0000000000000000000000000000000000000000
AMPS_RELAYER_URL=http://relayer:8080
AMPS_RELAYER_ID=amps-keeper
RELAYER_API_KEY=change-me
RELAYER_KEYSTORE_PASSPHRASE=change-me

# --- economics ------------------------------------------------------------------------------------------------
# ETH price, 18 decimals. Zero disables the bounty-versus-gas check, which is the honest setting until Phase 0
# resolves the ETH/USD feed on 4663. 2500e18 = 2500000000000000000000.
AMPS_ETH_USD18=0
AMPS_RUN_UNPAID=false

# --- operations -----------------------------------------------------------------------------------------------
AMPS_SCAN_INTERVAL_SECONDS=15
AMPS_METRICS_PORT=9464
AMPS_LOG_LEVEL=info
GRAFANA_PASSWORD=admin
