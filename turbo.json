{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc", "pnpm-lock.yaml"],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/README.md"
      ],
      "outputs": [
        "dist/**",
        "out/**",
        ".next/**",
        "!.next/cache/**",
        "generated/**"
      ]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "fmt": {
      "cache": false,
      "outputs": []
    },
    "generate": {
      "cache": false,
      "outputs": []
    }
  }
}
