# turbo fans tasks out across packages and pnpm 10's pre-run dependency check races on its
# shared workspace-state file, producing "Unexpected end of JSON input". Verification happens
# in CI at install time (`pnpm install --frozen-lockfile`), so turn the per-run check off.
verify-deps-before-run=false

# Keep peer-dependency noise from wagmi 2's WalletConnect tree (React 19) non-fatal.
strict-peer-dependencies=false

# Placeholder apps declare heavy deps (next, ponder) they do not yet use.
auto-install-peers=true
